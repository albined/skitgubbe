# Skitgubbe Configuration Template

# JSON Web Token Secret (Keep this private and secure in production)
# In production, specify a strong secret key. If left blank, the server will generate a secure persistent key.
JWT_SECRET=

# Development Settings Toggle (true / false)
# When set to false, debug cheats and reset options are disabled and blocked in both backend and frontend.
PUBLIC_ALLOW_DEV_SETTINGS=false

# Port mapping for Nginx Gateway (accessible on the host)
GATEWAY_PORT=80

# --- Advanced Settings (Optional overrides) ---
# DATABASE_PATH=/app/data/skitgubbe.db
# PORT=3000
# HOST=0.0.0.0

# --- Web Push VAPID Keys (Optional, auto-generated if not specified) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Android Push / Firebase Admin (Optional) ---
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project

# Informational value returned by GET /api/app-info
# SERVER_VERSION=git-sha-or-release-name
