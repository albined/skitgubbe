{
	"name": "skitgubbe-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev:server": "bun --filter server dev",
		"dev:web": "bun --filter web dev",
		"dev": "bun run --parallel dev:*",
		"check": "bun run check:web && bun run check:server",
		"check:web": "bun --filter web check",
		"check:server": "bun --filter server check",
		"test:server": "bun --filter server test",
		"test": "bun test",
		"lint": "bunx prettier --check \"packages/server/**/*.ts\" \"packages/shared/**/*.ts\" \"*.json\" \"packages/server/*.json\" \"packages/shared/*.json\" && bun --filter web lint",
		"format": "bunx prettier --write \"packages/server/**/*.ts\" \"packages/shared/**/*.ts\" \"*.json\" \"packages/server/*.json\" \"packages/shared/*.json\" && bun --filter web format"
	}
}
